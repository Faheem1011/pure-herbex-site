# PURE HERBEX ENTERPRISE SECURITY & CACHE-CONTROL HEADERS

<IfModule mod_headers.c>
    # 1. Content Security Policy (CSP) - Mitigate XSS & Unsafe Injections
    Header set Content-Security-Policy "default-src 'self' https: data: blob: 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; object-src 'none'; base-uri 'self';"

    # 2. HTTP Strict Transport Security (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # 3. Cross-Origin Opener Policy (COOP)
    Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"

    # 4. Prevent MIME Sniffing
    Header set X-Content-Type-Options "nosniff"

    # 5. Prevent Clickjacking
    Header set X-Frame-Options "SAMEORIGIN"

    # 6. Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# STRICT CACHE CONTROL FOR SPA & DYNAMIC REFRESH
# Never cache index.html or root page requests so updates are instant across Hostinger CDN / LiteSpeed
<FilesMatch "\.(html|htm)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set X-LSCACHE-Control "no-cache"
    </IfModule>
</FilesMatch>

# Hashed assets in /assets/ (JS/CSS) can be cached safely since Vite changes hashes on every build
<LocationMatch "^/assets/">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</LocationMatch>

# Static images in /images/ should revalidate daily to pick up updated high-res assets
<FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
    <IfModule mod_headers.c>
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </IfModule>
</FilesMatch>

# Leverage Browser Caching Defaults
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 day"
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType image/png "access plus 1 day"
    ExpiresByType image/webp "access plus 1 day"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# SPA Fallback Routing for React SPA
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>
